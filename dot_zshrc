bindkey -e

# Dumb terminal fallback
# Useful for Emacs shell, comint, TRAMP etc
if [[ "${TERM}" == "dumb" ]]; then
    PROMPT='%n@%m:%~'$'\n''> '
    PS2='> '
    return
fi

