# -- Colors and prompts ------------------------------------------------------

autoload -Uz vcs_info
autoload -Uz add-zsh-hook

function dir_trim() {
  local dir="${PWD}"

  if [[ "${dir}" == "${HOME%/}" ]]; then
    dir="~"
  elif [[ "${dir}" == "${HOME%/}/"* ]]; then
    dir="~/${dir#${HOME%/}/}"
  fi

  local -a parts
  parts=("${(@s:/:)dir}")

  if (( "${#dir}" > 35 && "${#parts}" > 4 )); then
    local hidden_count=$(( "${#parts}" - 4 ))
    dir="${parts[1]}/${parts[2]}/..${hidden_count}../${parts[-2]}/${parts[-1]}"
  fi

  print -r -- "${dir}"
}

function osc7-pwd() {
    printf '\e]7;file://%s%s\e\' "${HOST}" "${PWD//(#m)([^@-Za-z&-;_~])/%${(l:2::0:)$(([##16]#MATCH))}}"
}

function chpwd-osc7-pwd() {
    (( ZSH_SUBSHELL )) || osc7-pwd
}
add-zsh-hook -Uz chpwd chpwd-osc7-pwd

zstyle ':vcs_info:*' formats '(%b) %m'
zstyle ':vcs_info:*' actionformats '(%b|%a) %m'

zstyle ':vcs_info:git*+set-message:*' hooks git-check
+vi-git-check() {
    [[ -d .git ]] || git rev-parse --git-dir >/dev/null 2>&1 || return 0

    local upstream
    if upstream=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null) &&
            [[ -n "$upstream" ]] && [[ "$upstream" != "@{upstream}" ]]
    then
        local -a counts
        if counts=(${(s: :)$(git rev-list --left-right --count "$upstream"...HEAD 2>/dev/null)}); then
            [[ ${counts[2]:-0} -gt 0 ]] && hook_com[misc]+="u${counts[2]}"
            [[ ${counts[1]:-0} -gt 0 ]] && hook_com[misc]+="d${counts[1]}"
        fi
    fi

    local diff_index
    diff_index=("${(@f)$(git diff-index --name-only HEAD 2>/dev/null)}")
    [[ ${#diff_index:#} -ge 1 ]] && hook_com[misc]+="!${#diff_index:#}"
}

_shlvl() {
    local lvl="${SHLVL:-1}" em=emacs out e
    local -a ctx

    [[ -n "${TMUX}" ]] && { (( lvl-- )); ctx+=( tmux ) }

    if [[ -n "${INSIDE_EMACS}" ]]; then
        (( lvl-- ))
        for e (ghostel vterm eat) { [[ "${INSIDE_EMACS}" == *$e* ]] && { em=$e; break } }
        ctx+=( "${em}" )
    fi

    if [[ -n "${LF_LEVEL}" ]]; then
        local lfl=1
        [[ "${LF_LEVEL}" == <-> ]] && lfl="${LF_LEVEL}"
        (( lvl -= lfl ))
        (( lfl > 1 )) && ctx+=( "lf(${lfl})" ) || ctx+=( lf )
    fi

    (( lvl < 1 )) && lvl=1
    out="${(j:+:)ctx}"
    (( lvl > 1 )) && out+="${out:++}${lvl}"
    [[ -n "${out}" ]] && print -Pn "%F{8}${out}%f "
}

precmd() {
    # init vcs info
    vcs_info

    local dir_trim="$(dir_trim)"
    local title="%n@%m:${dir_trim}"

    # set window title bar
    print -Pn "\e]0;${title}\a"

    # empty line before the prompt
    print

    # check for ssh session
    [[ "$is_ssh" == true ]] && {
        print -Pn "%F{242}${USER}@${HOST%%.*}%f "
    }

    _shlvl

    # print current directory
    print -Pn "%F{cyan}${dir_trim}%f "

    # print git prompt
    print -Pn "%F{8}${vcs_info_msg_0_}%f"

    # new line ("\n")
    print

    # setup main prompt
    PROMPT="%(?.%F{magenta}.%F{red})❯%f "
    # RPROMPT='%F{245}%*%f' # time

    PS2="%F{cyan}> %f"
    # RPS2="%F{cyan}<%f"
}

