    eval "$(direnv hook zsh)"
fi

_my_load_zsh_plugin() {
    local name="$1"
    local base dir

    for base in \
        "/usr/share/zsh/plugins" \
        "/opt/local/share"; do
        [[ -d "${base}" ]] && dir="${base}/${name}"
        [[ -f "${dir}/${name}.zsh" ]] && { source "${dir}/${name}.zsh"; return 0; }
    done
    return 1
}

# Fish-like syntax highlighting and autosuggestions
# NixOS: plugins successful loading by configuration.nix
if [[ "$is_nixos" == false ]]; then
    _my_load_zsh_plugin "zsh-autosuggestions"
    _my_load_zsh_plugin "zsh-syntax-highlighting"
fi
