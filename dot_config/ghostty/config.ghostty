font-family = "Iosevka Curly"
font-size = 11

background = 1B1D1E
foreground = CCCCCC
selection-foreground = 000000
selection-background = FFFACD

# black
palette = 0=1B1D1E
palette = 8=808080
# red
palette = 1=FF0044
palette = 9=F92672
# green
palette = 2=82B414
palette = 10=A6E22E
# yellow
palette = 3=FD971F
palette = 11=E6DB74
# blue
palette = 4=266C98
palette = 12=7070F0
# magenta
palette = 5=AC0CB1
palette = 13=D63AE1
# cyan
palette = 6=00AAAA
palette = 14=66D9EF
# white
palette = 7=CCCCCC
palette = 15=F8F8F2

cursor-color = F92672
cursor-style = block
shell-integration-features = no-cursor
cursor-click-to-move = true
mouse-hide-while-typing = true

window-height = 35
window-width  = 88

grapheme-width-method = legacy

# Fix non-Latin keymaps
## Terminal control characters
keybind = ctrl+key_c=text:\x03
keybind = ctrl+key_d=text:\x04
keybind = ctrl+key_z=text:\x1a
keybind = ctrl+key_v=text:\x16
keybind = ctrl+key_r=text:\x12
keybind = ctrl+key_l=text:\x0c
keybind = ctrl+key_u=text:\x15
keybind = ctrl+key_a=text:\x01
keybind = ctrl+key_e=text:\x05
keybind = ctrl+key_k=text:\x0b
keybind = ctrl+key_w=text:\x17
## Ghostty UI actions
keybind = ctrl+shift+key_c=copy_to_clipboard:mixed
keybind = ctrl+shift+key_v=paste_from_clipboard
keybind = ctrl+shift+key_w=close_surface
keybind = ctrl+shift+key_t=new_tab
keybind = ctrl+shift+key_o=new_split:right
keybind = ctrl+shift+key_e=new_split:down
keybind = ctrl+shift+key_n=new_window
keybind = ctrl+shift+key_q=quit
keybind = ctrl+shift+key_f=start_search
keybind = ctrl+shift+key_j=write_screen_file:paste,plain
keybind = ctrl+shift+key_a=select_all
keybind = ctrl+shift+key_i=inspector:toggle
keybind = ctrl+shift+key_p=toggle_command_palette